[Unit]
Description=ztWhatsApp notifications
After=zrn-ztwhatsappd.service
# Not Requires: it reconnects whenever the engine comes back.

[Service]
ExecStart=/usr/bin/ztwhatsapp-notify
# A second copy finds the lock taken and exits 3: not restarted.
Restart=always
RestartPreventExitStatus=3
RestartSec=3
Nice=5
NoNewPrivileges=yes
MemoryHigh=24M

[Install]
WantedBy=default.target
